# Copy this file to .env.local for local development, and set the same
# keys in your deployment platform (Netlify) for production/preview.
# See docs/ENVIRONMENT_VARIABLES.md for full descriptions.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Neon Postgres (required for forms and Studio) ---
# Use Neon's pooled connection string. Never expose this to the browser.
DATABASE_URL=

# --- Better Auth (required for Studio) ---
# Generate a high-entropy secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated emails permitted to enter /studio.
FOUNDER_EMAILS=

# --- Resend (optional) ---
# Enables transactional emails (beta confirmation, contact notifications).
# Forms work without it - emails are just skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VelNit Life <hello@velnit.life>

# --- Content Operating System / VelNit Studio (Phase B) ---
# Required only to generate drafts in /studio. The Studio workspace itself
# still works without these (founders can still create ideas/briefs and
# review/edit manually) - only AI generation is disabled until both are set.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Set to whatever Claude model your Anthropic account has access to.
ANTHROPIC_MODEL=
